#!/bin/bash
# monitoring_coverage_analyzer-setup - post-install setup for the
# monitoring_coverage_analyzer MKP (analogous to orbvis-setup).
#
# MKPs cannot register cron jobs themselves (etc/cron.d/ is not a
# PackagePart). This script installs/removes the site crontab snippet once.
#
# Commands (run as the OMD site user):
#   monitoring_coverage_analyzer-setup            - install / update cron jobs
#   monitoring_coverage_analyzer-setup status     - show cron + last run state
#   monitoring_coverage_analyzer-setup uninstall  - remove cron jobs
#
# Idempotent: re-running "setup" after an MKP update simply rewrites the
# cron snippet from the template shipped in the MKP.
set -euo pipefail

BOLD='\033[1m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; RED='\033[0;31m'; RESET='\033[0m'
step()  { echo -e "  ${BOLD}▸ $*${RESET}"; }
ok()    { echo -e "  ${GREEN}✓ $*${RESET}"; }
warn()  { echo -e "  ${YELLOW}⚠ $*${RESET}"; }
die()   { echo -e "\n${RED}Error: $*${RESET}\n" >&2; exit 1; }

SITE="${OMD_SITE:-}"
ROOT="${OMD_ROOT:-}"
[[ -z "$SITE" || -z "$ROOT" ]] && die "Run as the OMD site user (OMD_SITE / OMD_ROOT must be set).\nExample: su - <SITE> -c 'monitoring_coverage_analyzer-setup'"
[[ "$(id -u)" -eq 0 ]] && die "Do not run as root. Example: su - $SITE -c 'monitoring_coverage_analyzer-setup'"

PKG="monitoring_coverage_analyzer"
# PackagePart.DOC installs to local/share/doc/check_mk/ (cmk.utils.paths.local_doc_dir)
TEMPLATE="$ROOT/local/share/doc/check_mk/$PKG/$PKG.cron"
CRON_FILE="$ROOT/etc/cron.d/$PKG"
CRON_BIN="$ROOT/local/bin/${PKG}_cron"
CACHE_FILE="$ROOT/var/check_mk/web/${PKG}_cache.json"

CMD="${1:-setup}"

cron_active() {
  crontab -l 2>/dev/null | grep -v '^[[:space:]]*#' | grep -q "${PKG}_cron"
}

case "$CMD" in

# ---------------------------------------------------------------------------
setup)
# ---------------------------------------------------------------------------
  [[ -f "$TEMPLATE" ]] || die "Cron template not found at $TEMPLATE\nDid you install the $PKG MKP first?"
  [[ -x "$CRON_BIN" ]] || die "Cron trigger script not found/executable at $CRON_BIN\nDid you install the $PKG MKP first?"

  echo ""
  echo -e "${BOLD}Monitoring Coverage Analyzer - Post-Install Setup${RESET}"
  echo "  Site: $SITE  ($ROOT)"
  echo ""

  step "Installing cron jobs"
  mkdir -p "$(dirname "$CRON_FILE")"
  if [[ -f "$CRON_FILE" ]] && cmp -s "$TEMPLATE" "$CRON_FILE"; then
    ok "$CRON_FILE already up to date"
  else
    # Atomic replace: stage next to the target, then rename().
    TMP="$(mktemp "$CRON_FILE.XXXXXX")"
    cp "$TEMPLATE" "$TMP"
    chmod 0644 "$TMP"
    mv -f "$TMP" "$CRON_FILE"
    ok "$CRON_FILE written"
  fi

  step "Reloading site crontab"
  omd reload crontab >/dev/null
  if cron_active; then
    ok "Cron jobs active"
  else
    die "Cron jobs not found in the site crontab after 'omd reload crontab'.\nIs the crontab service enabled? (omd config show CRONTAB)"
  fi

  echo ""
  echo -e "${GREEN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  echo -e "${GREEN}${BOLD}  Setup complete.${RESET}"
  echo -e "${GREEN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  echo ""
  echo "  Jobs:"
  grep -v '^\s*#' "$CRON_FILE" | grep -v '^\s*$' | sed 's/^/    /'
  echo ""
  echo "  The full analysis runs daily at 05:00 (if due)."
  echo "  To run it right away:"
  echo "    ${PKG}_cron fullrun"
  echo ""
  ;;

# ---------------------------------------------------------------------------
status)
# ---------------------------------------------------------------------------
  echo ""
  echo -e "${BOLD}Monitoring Coverage Analyzer - Status${RESET}"
  echo "  Site: $SITE  ($ROOT)"
  echo ""
  if [[ -f "$CRON_FILE" ]]; then
    ok "Cron file present: $CRON_FILE"
    if [[ -f "$TEMPLATE" ]] && ! cmp -s "$TEMPLATE" "$CRON_FILE"; then
      warn "Cron file differs from the MKP template - re-run: monitoring_coverage_analyzer-setup"
    fi
  else
    warn "Cron file missing - run: monitoring_coverage_analyzer-setup"
  fi
  if cron_active; then ok "Cron jobs active in site crontab"; else warn "Cron jobs NOT active in site crontab"; fi
  if [[ -f "$CACHE_FILE" ]]; then
    python3 - "$CACHE_FILE" <<'EOF'
import json, sys, time
d = json.load(open(sys.argv[1]))
fmt = lambda t: time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(t)) if t else "never"
print("  Last full run:              ", fmt(d.get("last_full_run_timestamp")))
print("  Last piggyback refresh:     ", fmt(d.get("last_piggyback_refresh_timestamp")))
EOF
  else
    warn "No analysis result yet ($CACHE_FILE)"
  fi
  echo ""
  ;;

# ---------------------------------------------------------------------------
uninstall)
# ---------------------------------------------------------------------------
  echo ""
  echo -e "${BOLD}Monitoring Coverage Analyzer - Uninstall cron jobs${RESET}"
  echo "  Site: $SITE  ($ROOT)"
  echo ""
  step "Removing cron jobs"
  rm -f "$CRON_FILE"
  omd reload crontab >/dev/null
  if cron_active; then
    die "Cron jobs still present in the site crontab."
  fi
  ok "Cron jobs removed"
  echo ""
  echo -e "  ${YELLOW}${BOLD}Next step (optional): remove the MKP package:${RESET}"
  echo "    mkp disable $PKG"
  echo "    mkp remove $PKG"
  echo ""
  ;;

*)
  die "Unknown command: $CMD\nUsage: monitoring_coverage_analyzer-setup [setup|status|uninstall]"
  ;;

esac
