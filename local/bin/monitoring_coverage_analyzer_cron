#!/usr/bin/env python3
"""Cron and background entry point of monitoring_coverage_analyzer.

    monitoring_coverage_analyzer_cron refresh   # every 5 min
    monitoring_coverage_analyzer_cron fullrun   # daily
    monitoring_coverage_analyzer_cron rerun     # started by the GUI page
"""
# refresh: schreibt das letzte Ergebnis erneut als Piggyback-Daten.
# fullrun: neue Analyse, wenn piggyback_interval_hours abgelaufen ist.
# rerun:   neue Analyse sofort ("Re-run analysis" auf der GUI-Seite, laeuft
#          als eigener Prozess ausserhalb von Apache).
#
# 0.9.0-b25: refresh und die Pruefung "fullrun faellig?" laufen OHNE die
# Checkmk-GUI (lib/runstate.py). Das Hochfahren der GUI
# (main_modules.register) kostet je nach System 3-20 s und wird nur noch
# fuer einen echten Analyse-Lauf gebraucht.
from __future__ import annotations

import sys
import time
import traceback

MODES = ("refresh", "fullrun", "rerun")


def _run_analysis() -> tuple[int, int, str | None]:
    """Laedt die GUI und das Seitenmodul und fuehrt einen kompletten
    Analyse-Lauf aus (inkl. Speichern und Piggyback)."""
    # main_modules.register() muss vor application_and_request_context()
    # laufen (sonst KeyError im features_registry) - derselbe Aufruf wie in
    # cmk-update-config.
    from cmk.ccc.version import edition
    from cmk.gui import main_modules
    from cmk.utils import paths as cmk_paths

    main_modules.register(edition(cmk_paths.omd_root))

    from cmk.gui.utils.script_helpers import application_and_request_context

    with application_and_request_context():
        # Page-Plugins werden von der GUI per exec() geladen und sind nicht
        # importierbar - daher direkt ueber den Dateipfad laden.
        import importlib.util
        from pathlib import Path

        plugin_path = (
            Path(cmk_paths.local_web_dir) / "plugins" / "pages" / "monitoring_coverage_analyzer.py"
        )
        spec = importlib.util.spec_from_file_location(
            "monitoring_coverage_analyzer_page_module", plugin_path
        )
        if spec is None or spec.loader is None:  # pragma: no cover - defensiv
            raise RuntimeError(f"cannot load GUI page module {plugin_path}")
        page_module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(page_module)
        return page_module._run_analysis_and_store()


def _analysis_job(runstate, mode: str) -> int:
    with runstate.job_lock() as acquired:
        if not acquired:
            print(f"{mode}: skipped, another analysis run is active")
            return 0
        started = time.time()
        runstate.save_job_state(state="running", mode=mode, started=started, finished=None, error=None)
        try:
            hosts, written, error = _run_analysis()
        except Exception as exc:  # Fehler fuer die GUI-Seite festhalten
            traceback.print_exc()
            runstate.save_job_state(state="failed", finished=time.time(), error=f"{exc!r}")
            return 1
        runstate.save_job_state(
            state="done" if error is None else "failed",
            finished=time.time(),
            hosts=hosts,
            error=None if error is None else f"piggyback: {error}",
        )
        print(
            f"{mode}: hosts={hosts} piggyback_written={written} error={error} "
            f"duration={time.time() - started:.1f}s"
        )
        return 0 if error is None else 1


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[1] not in MODES:
        print(f"Usage: monitoring_coverage_analyzer_cron {{{'|'.join(MODES)}}}", file=sys.stderr)
        return 2
    mode = argv[1]

    from cmk_addons.plugins.monitoring_coverage_analyzer.lib import runstate

    if mode == "refresh":
        written, error = runstate.run_piggyback_refresh()
        print(f"refresh: written={written} error={error}")
        return 0 if error is None else 1

    if mode == "fullrun":
        due, reason = runstate.is_full_run_due(force=False)
        if not due:
            print(f"fullrun: skipped, not due ({reason})")
            return 0

    return _analysis_job(runstate, mode)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
